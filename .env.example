# Copy to .env and fill in. (Docker Compose planned later; these values work as-is.)

# --- database ---
# The worker repo uses this same DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@localhost:5432/app
WEB_PORT=3000

# --- AI ---
OPENAI_API_KEY=
# Codex-compatible model available to the web service's API key.
CODEX_MODEL=

# --- LINE ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=

NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Switch the agent to the local mock path (demo fallback).
MOCK_AGENT=false

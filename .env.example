# Copy to .env and fill in. docker compose reads .env automatically.

# --- database ---
# The worker repo uses this same DATABASE_URL (host `db` when co-located).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@db:5432/app
WEB_PORT=3000

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LINE ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Switch the agent to the local mock path (demo fallback).
MOCK_AGENT=false
